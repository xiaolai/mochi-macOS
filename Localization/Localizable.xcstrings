    "Talk to Mochi" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和 Mochi 说话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和 Mochi 說話"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiに話しかける"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi에게 말하기"
          }
        }
      }
    },
    "Talk with %@ in %@. When you get stuck,\nwe’ll find the words and practise them in your own voice." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@と%2$@で話しましょう。言葉に詰まったら、\n一緒に言い方を見つけて、自分の声で練習しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@와(과) %2$@로 이야기해 보십시오. 말이 막히면\n알맞은 표현을 찾아 직접 목소리로 연습할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用%2$@和%1$@聊天。卡壳时，\n我们会帮你找到合适的说法，并用你自己的声音练习。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用%2$@和 %1$@ 聊天。卡住的時候，\n我們會一起找出說法，並用你自己的聲音練習。"
          }
        }
      }
    },
    "Talk with %@ in any language.\nReplies follow the language you speak." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@とどの言語でも話せます。\n返答はあなたが話す言語に合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@와(과) 어떤 언어로든 이야기해 보십시오.\n답변은 사용자가 말하는 언어를 따릅니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用任何语言和%@聊天。\n回复会跟随你说的语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用任何語言和 %@ 聊天。\n回覆會跟隨你說的語言。"
          }
        }
      }
    },
