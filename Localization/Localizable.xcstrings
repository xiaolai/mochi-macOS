    "Choose a .mochilibrary or older .enjoylibrary backup. Missing items are added; matching IDs keep the local version." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".mochilibrary または以前の .enjoylibrary バックアップを選択してください。足りない項目は追加され、IDが一致する項目はローカルのバージョンが保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".mochilibrary 또는 이전 .enjoylibrary 백업을 선택하십시오. 없는 항목은 추가되며, ID가 일치하는 항목은 로컬 버전이 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 .mochilibrary 或旧版 .enjoylibrary 备份。缺少的项目将被添加；ID 相同的项目保留本地版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
