          }
        }
      }
    },
    "Your typed thought is kept. Choose how to use these words." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力した言いたいことは保持されています。認識された言葉の使い方を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
