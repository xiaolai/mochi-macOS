          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 Codex는 Mochi에서 사용하기에 너무 오래되었습니다. Codex를 %@ 이상으로 업데이트한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
