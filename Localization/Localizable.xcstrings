      }
    },
    "Mochi calls you by this name. Leave it empty and she won’t use one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi はこの名前であなたを呼びます。空欄にすると名前を使いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 이 이름으로 당신을 부릅니다. 비워 두면 이름을 사용하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 会用这个名字称呼你。留空则不使用名字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 會用這個名字稱呼你。留空則不使用名字。"
          }
        }
      }
    },
    "Mochi can’t use this name. Use up to %lld characters on one line." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi はこの名前を使えません。1 行、%lld 文字以内にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 이 이름을 사용할 수 없습니다. 한 줄, %lld자 이내로 입력하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法使用这个名字。请使用一行、不超过 %lld 个字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法使用這個名字。請使用一行、不超過 %lld 個字元。"
          }
        }
      }
    },
    "Mochi could not check its library file, so it did not start a new library." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi はライブラリファイルを確認できなかったため、新しいライブラリを作成しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 라이브러리 파일을 확인할 수 없어 새 라이브러리를 만들지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法检查其资料库文件，因此没有新建资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法檢查其資料庫檔案，因此沒有新建資料庫。"
          }
        }
      }
    },
    "Mochi could not check this attempt. The attempt itself is saved." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiはこの練習を確認できませんでした。録音そのものは保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 이번 연습을 확인하지 못했습니다. 녹음 자체는 저장되어 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法检查这次练习。录音本身已保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法檢查這次練習。錄音本身已儲存。"
          }
        }
      }
    },
    "Mochi could not complete that response. Please retry." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiはその応答を完了できませんでした。再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 응답을 완료할 수 없습니다. 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法完成该回复。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法完成該回應。請重試。"
          }
        }
      }
    },
    "Mochi could not execute this action." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiはこの操作を実行できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 이 동작을 실행할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法执行此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法執行此動作。"
          }
        }
      }
    },
    "Mochi could not get your sign-in from Codex. Check that Codex works on this Mac, then retry." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MochiはCodexからサインインを取得できませんでした。このMacでCodexが動作することを確認してから、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 Codex에서 로그인 정보를 가져오지 못했습니다. 이 Mac에서 Codex가 작동하는지 확인한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法从 Codex 获取你的登录信息。请确认 Codex 在这台 Mac 上可以正常运行，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法從 Codex 取得你的登入資訊。請確認 Codex 在這台 Mac 上能正常運作，然後重試。"
          }
        }
      }
    },
    "Mochi could not move your library into its folder: %@ Your data has not been changed. Reveal the data folder from Settings to review it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiはライブラリを自身のフォルダに移動できませんでした：%@ データは変更されていません。「設定」からデータフォルダを表示して確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 라이브러리를 Mochi 폴더로 옮길 수 없습니다: %@ 데이터는 변경되지 않았습니다. 확인하려면 설정에서 데이터 폴더를 여십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 无法将你的资料库移到其文件夹：%@ 你的数据未被更改。请从“设置”中显示数据文件夹进行检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 無法將你的資料庫搬移到其檔案夾：%@ 你的資料未被更改。請從「設定」顯示資料檔案夾以檢查。"
          }
        }
      }
    },
    "Mochi could not start listening in time. Check your connection; press to send still works." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiは時間内に聞き取りを開始できませんでした。接続を確認してください。押して送信は引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi가 제때 듣기를 시작하지 못했습니다. 연결을 확인하십시오. 눌러서 보내기는 계속 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 未能及时开始聆听。请检查网络连接；按键发送仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochi 未能及時開始聆聽。請檢查網路連線；按鍵傳送仍可使用。"
          }
        }
      }
    },
    "Mochi couldn’t save your library" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mochiはライブラリを保存できませんでした"
