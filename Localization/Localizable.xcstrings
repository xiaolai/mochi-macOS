          }
        }
      }
    },
    "A secure connection to %@ could not be established. A proxy, VPN or security tool may be intercepting it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@への安全な接続を確立できませんでした。プロキシ、VPN、またはセキュリティツールが通信に介入している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 대한 보안 연결을 설정할 수 없습니다. 프록시, VPN 또는 보안 도구가 가로채고 있을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法与 %@ 建立安全连接。可能有代理、VPN 或安全工具正在拦截。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法與 %@ 建立安全連線。可能有代理伺服器、VPN 或安全工具正在攔截。"
          }
        }
      }
    },
    "A template ID is required." : {
