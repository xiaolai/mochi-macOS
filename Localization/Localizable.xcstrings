    "From Apple speech recognition on this Mac. It also misses some words said well, so treat this as a hint, not a score." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacのApple音声認識による結果です。正しく発音した語を聞き逃すこともあるため、採点ではなく目安としてご利用ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 Apple 음성 인식 결과입니다. 잘 발음한 단어를 놓치기도 하므로 점수가 아니라 참고로만 보십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "结果来自这台 Mac 上的 Apple 语音识别。它也会漏掉一些读得很好的词，所以请把它当作提示，而不是评分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結果來自這台 Mac 上的 Apple 語音辨識。它也會漏掉一些唸得很好的詞，所以請把它當作提示，而不是評分。"
          }
        }
      }
    },
