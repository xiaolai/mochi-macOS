        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대화에서 더 이상 해당 표현을 사용할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
