    "Microphone access is off. Enable Mochi in System Settings → Privacy & Security → Microphone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスがオフになっています。「システム設定」→「プライバシーとセキュリティ」→「マイク」でMochiを有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 접근이 꺼져 있습니다. 시스템 설정 → 개인정보 보호 및 보안 → 마이크에서 Mochi를 활성화하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问已关闭。请在“系统设置”→“隐私与安全性”→“麦克风”中启用 Mochi。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麥克風取用權限已關閉。請在「系統設定」→「隱私權與安全性」→「麥克風」中啟用 Mochi。"
          }
        }
      }
    },
