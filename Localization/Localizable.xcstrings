    "Spoken exactly as written when you first start talking. Leave it empty for a standard greeting in the conversation’s language." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初に話し始めるとき、書かれたとおりに読み上げられます。空欄にすると、会話の言語で標準のあいさつをします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 대화를 시작할 때 적힌 그대로 말합니다. 비워 두면 대화 언어로 기본 인사를 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一次开始说话时，会按原样念出。留空则用对话语言说一句标准问候。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一次開始說話時，會照原樣念出。留空則用對話語言說一句標準問候。"
          }
        }
      }
    },
