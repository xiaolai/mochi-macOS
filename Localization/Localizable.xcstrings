          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 傳回了無效的回應。"
          }
        }
      }
    },
    "%@ usage limit reached. Retry later." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の使用量の上限に達しました。しばらくしてから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
