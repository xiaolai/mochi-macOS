        }
      }
    },
    "Your saved library could not be opened. %@ It has not been overwritten. Choose Restore Earlier Copy in Settings → Storage to reinstate the version saved just before it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたライブラリを開けませんでした。%@ ライブラリは上書きされていません。直前に保存されたバージョンに戻すには、「設定」→「ストレージ」で「以前のコピーを復元」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 라이브러리를 열 수 없습니다. %@ 라이브러리는 덮어쓰이지 않았습니다. 바로 전에 저장된 버전으로 되돌리려면 설정 → 저장 공간에서 ‘이전 사본 복원’을 선택하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开你已保存的资料库。%@ 该文件未被覆盖。请在“设置 → 存储”中选择“恢复较早副本”，以恢复在此之前保存的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法打開你已儲存的資料庫。%@ 它未被覆寫。請在「設定」→「儲存空間」中選擇「回復較早的副本」，以恢復在此之前儲存的版本。"
          }
        }
      }
    },
    "Your saved library could not be opened. %@ It has not been overwritten. Reveal the data folder from Settings to recover it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたライブラリを開けませんでした。%@ ライブラリは上書きされていません。復元するには「設定」からデータフォルダを表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 라이브러리를 열 수 없습니다. %@ 라이브러리는 덮어쓰이지 않았습니다. 복구하려면 설정에서 데이터 폴더를 여십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开你已保存的资料库。%@ 该文件未被覆盖。请从“设置”中显示数据文件夹以恢复它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
