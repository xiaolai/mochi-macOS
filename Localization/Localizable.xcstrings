    },
    "Your voice message could not be saved, so Mochi did not reply to it. Check the disk and the data folder, then record it again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声メッセージを保存できなかったため、Mochi は返信しませんでした。ディスクとデータフォルダを確認してから、もう一度録音してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 메시지를 저장할 수 없어 Mochi가 답하지 않았습니다. 디스크와 데이터 폴더를 확인한 다음 다시 녹음하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存你的语音消息，因此 Mochi 没有回复。请检查磁盘和数据文件夹，然后重新录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存你的語音訊息，因此 Mochi 沒有回覆。請檢查磁碟和資料檔案夾，然後重新錄製。"
          }
        }
      }
    },
    "Your voice message could not be saved, so Mochi did not reply to it. Its recording is kept in the data folder as “%@”." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声メッセージを保存できなかったため、Mochi は返信しませんでした。録音はデータフォルダに「%@」として保存されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 메시지를 저장할 수 없어 Mochi가 답하지 않았습니다. 녹음은 데이터 폴더에 “%@”(으)로 보관되어 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存你的语音消息，因此 Mochi 没有回复。录音已保留在数据文件夹中，名为“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存你的語音訊息，因此 Mochi 沒有回覆。錄音已保留在資料檔案夾中，名為「%@」。"
          }
        }
      }
    },
    "macOS already uses this shortcut." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 已在使用此快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 已在使用此快速鍵。"
          }
