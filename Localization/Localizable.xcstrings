    "1× is natural speed. Applies when generating speech; playback speed is separate." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1×が自然な速度です。音声の生成時に適用されます。再生速度とは別の設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1×는 자연스러운 속도입니다. 음성을 생성할 때 적용되며, 재생 속도는 별도입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1× 为自然语速。仅在生成语音时生效；播放速度另行设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1× 為自然語速。套用於產生語音時；播放速度另外設定。"
          }
        }
      }
    },
