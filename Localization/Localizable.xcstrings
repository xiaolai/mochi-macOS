    "Menus can’t tell number-pad keys from the same keys above the letters. Choose another key." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューではテンキーと文字キーの上にある同じキーを区別できません。別のキーを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴는 숫자 키패드의 키와 글자 위쪽의 같은 키를 구분하지 못합니다. 다른 키를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单无法区分数字小键盘上的键和字母键上方的相同按键。请选择其他按键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選單無法區分數字鍵盤上的按鍵和字母鍵上方的相同按鍵。請選擇其他按鍵。"
          }
        }
      }
    },
